{
  "name": "@ocker-ai/core",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Jenko <adam@isaidusaid.com>",
  "description": "Portable OCKER chronology model, Docling document import, LLM adapters and reusable browser UI",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./demo": "./demo/workbench.js",
    "./demo/code": {
      "types": "./demo/integration-code.d.ts",
      "import": "./demo/integration-code.js"
    },
    "./demo/documents": {
      "types": "./demo/document-import.d.ts",
      "import": "./demo/document-import.js"
    },
    "./demo/editor": {
      "types": "./demo/record-editor.d.ts",
      "import": "./demo/record-editor.js"
    },
    "./demo/providers": {
      "types": "./demo/provider-shortcuts.d.ts",
      "import": "./demo/provider-shortcuts.js"
    },
    "./demo/locales": {
      "types": "./demo/locales.d.ts",
      "import": "./demo/locales.js"
    },
    "./headless": {
      "types": "./src/headless.d.ts",
      "import": "./src/headless.js"
    },
    "./prepare-docling-assets": "./tools/prepare-docling-assets.mjs",
    "./themes": {
      "types": "./src/themes.d.ts",
      "import": "./src/themes/index.js"
    },
    "./themes.css": "./src/themes/index.css"
  },
  "files": [
    "src",
    "demo/workbench.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "demo/integration-code.js",
    "demo/integration-code.d.ts",
    "demo/document-import.js",
    "demo/document-import.d.ts",
    "demo/record-editor.d.ts",
    "demo/record-editor.js",
    "demo/provider-shortcuts.d.ts",
    "demo/provider-shortcuts.js",
    "demo/locales.d.ts",
    "demo/locales.js",
    "tools"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --config vite.library.config.js",
    "demo:build": "vite build",
    "test": "node --test test/*.test.js",
    "predev": "node ../../themes/prepare.mjs && node ../../prompt-library/prepare.mjs && node demo/prepare.js",
    "predemo:build": "node ../../themes/prepare.mjs && node ../../prompt-library/prepare.mjs && node demo/prepare.js",
    "pretest": "node ../../themes/prepare.mjs && node ../../prompt-library/prepare.mjs",
    "prebuild": "node ../../themes/prepare.mjs && node ../../prompt-library/prepare.mjs",
    "prepack": "node ../../themes/prepare.mjs && node ../../prompt-library/prepare.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@noble/hashes": "^2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "codemirror": "^6.0.2",
    "docling.rs-wasm": "2.52.9",
    "html-to-image": "1.11.13",
    "htmlparser2": "^12.0.0",
    "jspdf": "4.2.1",
    "mammoth": "^1.13.0",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ISaidUSaid/ocker-ai.git",
    "directory": "ri/js"
  },
  "bugs": {
    "url": "https://github.com/ISaidUSaid/ocker-ai/issues"
  },
  "homepage": "https://github.com/ISaidUSaid/ocker-ai#readme",
  "sideEffects": [
    "**/*.css"
  ]
}
