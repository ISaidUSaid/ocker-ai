{
  "type": "object",
  "properties": {
    "format": {
      "const": "ocker-document"
    },
    "version": {
      "const": "0.1.0"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "asset": {
      "$ref": "#/$defs/asset"
    }
  },
  "required": [
    "format",
    "version",
    "document"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocker.ai/spec/0.1.0/document.schema.json",
  "$defs": {
    "date": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "year",
            "range",
            "unknown"
          ]
        },
        "value": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "approximate": {
          "type": "boolean"
        },
        "basis": {
          "type": "string"
        }
      },
      "required": [
        "precision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "day"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "month"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "year"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "range"
              }
            }
          },
          "then": {
            "required": [
              "value",
              "end"
            ],
            "properties": {
              "value": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "end"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "enum": [
                  "day",
                  "month",
                  "year"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "end"
              ]
            }
          }
        }
      ]
    },
    "selector": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "page",
            "time",
            "frame"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "paragraphId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string"
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      },
      "required": [
        "documentId"
      ],
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "page",
        "text"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "affidavit",
            "order",
            "report"
          ]
        },
        "author": {
          "type": "string"
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "paragraphs"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "assertedBy": {
          "type": "string"
        },
        "actorIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "alleged",
            "agreed",
            "disputed",
            "unresolved"
          ]
        },
        "narrative": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "date",
        "sources"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "type": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "llm",
                "human",
                "imported"
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "authorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "method",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "type",
        "rationale",
        "provenance"
      ],
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "eventId",
        "body",
        "position",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "binding",
            "persuasive",
            "unspecified"
          ]
        },
        "color": {
          "type": "string",
          "enum": [
            "blue",
            "lavender",
            "mint",
            "peach",
            "slate"
          ]
        },
        "pinpoint": {
          "type": "string"
        },
        "court": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "eventId",
        "title",
        "citation",
        "type",
        "color",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "derivedFrom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      },
      "required": [
        "id",
        "name",
        "mediaType",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "uri"
          ]
        }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "object"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
